<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: title, done/total count, add button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="serif"
            android:letterSpacing="0.15"
            android:text="@string/header"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/title"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_add"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/gold_dark"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- Gold underline -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@color/gold" />

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_main"
            style="@style/TabText"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="@string/tab_main" />

        <TextView
            android:id="@+id/tab_side"
            style="@style/TabText"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="@string/tab_side" />

        <TextView
            android:id="@+id/tab_daily"
            style="@style/TabText"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="@string/tab_daily" />

        <TextView
            android:id="@+id/tab_event"
            style="@style/TabText"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="@string/tab_event" />
    </LinearLayout>

    <!-- Mission list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/empty"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
